{
  "name": "waterloo-tunnels",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "vendor": "cp node_modules/maplibre-gl/dist/maplibre-gl.js node_modules/maplibre-gl/dist/maplibre-gl.css public/vendor/",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch-osm": "tsx scripts/fetch-osm.ts",
    "check": "tsx scripts/check.ts",
    "build-data": "tsx scripts/build-connections.ts && tsx scripts/check.ts",
    "build-graph": "tsx scripts/build-graph.ts && tsx scripts/check-graph.ts",
    "check-graph": "tsx scripts/check-graph.ts",
    "check-indoor": "tsx scripts/check-indoor.ts",
    "check-all": "npm run check && npm run check-graph && npm run check-indoor",
    "indoor:setup": "python3 -m venv .venv && .venv/bin/pip install -r scripts/py/requirements.txt",
    "indoor:corpus": ".venv/bin/python scripts/py/corpus.py",
    "indoor:extract": ".venv/bin/python scripts/py/extract.py --all",
    "indoor:georef": ".venv/bin/python scripts/py/georef.py --all",
    "indoor:build": ".venv/bin/python scripts/py/pipeline.py",
    "indoor:qa": ".venv/bin/python scripts/py/qa.py",
    "indoor:floorshift": ".venv/bin/python scripts/py/floorshift.py"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
